 #!/bin/bash
 . /lib/functions.sh
 . /usr/share/openclash/uci.sh
+
+# Initialize missing numeric options without replacing existing user values.
+for option in auto_restart chnr_auto_update; do
+	uci -q get "openclash.config.$option" >/dev/null 2>&1 ||
+		uci -q set "openclash.config.$option=0"
+done
+uci -q commit openclash
 
